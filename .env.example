# Backend Environment Variables (for .env in backend directory, or configure directly in application.properties)
COHERE_API_KEY=your_cohere_api_key_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here



# Backend database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/todo_db?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace_with_your_local_password

# External integrations
COHERE_API_KEY=replace_with_your_cohere_api_key
SLACK_WEBHOOK_URL=replace_with_your_slack_webhook_url

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000